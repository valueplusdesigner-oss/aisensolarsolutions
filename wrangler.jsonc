{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aisen-solar-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/aisen-preview/api/*",
      "/blog",
      "/blog/*",
      "/aisen-preview/admin",
      "/aisen-preview/admin/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aisen-solar-staging",
      "database_id": "23a1c337-6c18-4644-8082-675026a8929e",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD_HASH",
      "SESSION_SECRET"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://www.aisensolarsolutions.com"
  }
}
